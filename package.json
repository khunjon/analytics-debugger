{
  "name": "analytics-debugger",
  "version": "0.1.0",
  "description": "Chrome side panel that shows which interactions send which analytics hits: Adobe Analytics, Adobe Web SDK and GA4, decoded.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khunjon/analytics-debugger.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "node scripts/deploy.mjs",
    "watch": "node scripts/deploy.mjs --watch",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
